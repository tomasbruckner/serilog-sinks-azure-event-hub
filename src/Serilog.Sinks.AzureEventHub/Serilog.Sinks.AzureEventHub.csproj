<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Write Serilog events to Azure Event Hub</Description>
    <VersionPrefix>7.0.0</VersionPrefix>
    <Authors>Tomas Bruckner</Authors>
    <Copyright>Copyright (c) Tomas Bruckner. Portions (c) Serilog Contributors (Apache-2.0).</Copyright>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Serilog.Sinks.AzureEventHub</AssemblyName>
    <AssemblyOriginatorKeyFile>../../assets/Serilog.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign Condition=" '$(OS)' != 'Windows_NT' ">true</PublicSign>
    <PackageId>TomasBruckner.Serilog.Sinks.AzureEventHub</PackageId>
    <PackageTags>serilog;azure;eventhub</PackageTags>
    <PackageProjectUrl>https://github.com/tomasbruckner/serilog-sinks-azure-event-hub</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/tomasbruckner/serilog-sinks-azure-event-hub</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Source Link: ship a snupkg symbol package and embed repo/source metadata so
         consumers can step into the source while debugging. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition=" '$(GITHUB_ACTIONS)' == 'true' ">true</ContinuousIntegrationBuild>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <RootNamespace>Serilog</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Packed into the nupkg so the listing renders on nuget.org. -->
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <!-- Batching is provided by Serilog 4 core (IBatchedLogEventSink); the
         separate Serilog.Sinks.PeriodicBatching package is no longer needed. -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Azure.Messaging.EventHubs" />
    <!-- Build-time only (PrivateAssets="All"): adds no runtime dependency. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
